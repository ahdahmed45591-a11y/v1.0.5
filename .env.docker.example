# Copiez ce fichier en .env.docker (ignore par git) et changez toutes les valeurs.
# demarrer_local.bat le fait automatiquement au premier lancement.
POSTGRES_DB=baou
POSTGRES_USER=baou
POSTGRES_PASSWORD=changez-moi
JWT_SECRET=changez-moi-par-une-valeur-aleatoire-longue

# Depots mobiles (paiement en ligne Jeko Africa) -- Cockpit Jeko > Parametres
# > API & Webhooks. Sans ces 4 valeurs, les depots renvoient une erreur claire
# au lieu d'etre acceptes (voir backend_django/api/jeko.py).
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
JEKO_WEBHOOK_SECRET=
